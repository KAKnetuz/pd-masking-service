# Скопируйте в .env и задайте значения. Файл .env не коммитится.
# Сгенерировать ключ: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
TOKEN_SECRET=

WORKERS=4
STORAGE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
MAPPING_TTL_SECONDS=3600
MAX_INFLIGHT=512
MAX_PAYLOAD_CHARS=1000000
LOG_LEVEL=INFO
