# Скопируйте в .env и задайте значения. Файл .env не коммитится.
# Сгенерировать ключ: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
TOKEN_SECRET=

WORKERS=4
STORAGE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
# Таймаут операций Redis (сек). При превышении операция повторяется один раз.
REDIS_TIMEOUT_SECONDS=2.0
# Размер пула соединений Redis на воркер.
REDIS_MAX_CONNECTIONS=64
MAPPING_TTL_SECONDS=3600
MAX_INFLIGHT=512
MAX_PAYLOAD_CHARS=1000000
LOG_LEVEL=INFO

# Внешняя LLM (AlfaGen) для демо-прокси. LLM_PROVIDER=stub — без сети.
LLM_PROVIDER=stub
LLM_BASE_URL=https://alfagen.alfabank.ru/continue-dev/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_CA_BUNDLE=certs/russian_trusted_ca_chain.pem
